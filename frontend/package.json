{
  "name": "pyshield-studio",
  "productName": "PyShield Studio",
  "version": "1.0.1",
  "description": "PyShield Studio - Offline Proctored Python Notebook & Security IDE",
  "author": "PyShield Team <support@pyshield.dev>",
  "homepage": "https://github.com/yash12345-ctrl/PyShield-Studio",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "backend": "../.venv/bin/python ../backend/run_backend.py",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:start": "electron electron/main.cjs",
    "electron:dev": "npm run build && electron electron/main.cjs",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:build:linux": "npm run build && electron-builder --linux AppImage",
    "electron:build:deb": "npm run build && bash build-deb.sh",
    "electron:build:all:linux": "npm run build && electron-builder --linux AppImage && bash build-deb.sh",
    "electron:build:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.pyshield.studio",
    "productName": "PyShield Studio",
    "copyright": "Copyright © 2026 PyShield Studio",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "icon": "electron/icons",
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "icon": "electron/icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PyShield Studio"
    }
  }
}
